{
  "name": "openshare",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "serve": "bun run build && bun run migrate:serve && OPENSHARE_PERSIST_PATH=.runtime/state bun run preview",
    "deploy": "bun run build && wrangler deploy",
    "test": "bun test tests/contracts.test.ts",
    "test:watch": "bun test --watch tests/contracts.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "migrate:local": "wrangler d1 migrations apply openshare --local",
    "migrate:serve": "wrangler d1 migrations apply openshare --local --persist-to .runtime/state",
    "migrate:remote": "wrangler d1 migrations apply openshare --remote"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.8.1",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bun": "^1.4.0",
    "@cloudflare/workers-types": "^4.20250829.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wrangler": "^4.4.0"
  }
}
